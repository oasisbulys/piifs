{
  "title": "Algebra — Seven-Day Course",
  "subtitle": "Polynomials, inequalities, matrices and abstract algebra",
  "description": "18 lectures, written exercises and a final assessment.",
  "dailyStructure": [
    {
      "label": "Lectures",
      "duration": "2–3 hours"
    },
    {
      "label": "Reading and proof reconstruction",
      "duration": "1½ hours"
    },
    {
      "label": "Problem solving",
      "duration": "2–2½ hours"
    },
    {
      "label": "Error review",
      "duration": "30 minutes"
    }
